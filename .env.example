# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development are printed by `npx supabase status`.

# --- Supabase (required) -----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
# Anon (or publishable) key. Safe to expose to the browser; access is governed by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role (or secret) key. Server-only. Used by the scheduled collector endpoint.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled jobs (optional) -----------------------------------------------
# Bearer token required by POST /api/jobs/rank-collection. Leave empty to disable the endpoint.
CRON_SECRET=

# --- Apple Ads: Search Term Popularity (optional) ----------------------------
# OAuth client-credentials for the Apple Ads Platform API. Without these the UI shows
# "Apple keyword popularity not connected" and everything else keeps working.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
# PEM-encoded EC private key (ES256). Escaped newlines (\n) are accepted.
APPLE_ADS_PRIVATE_KEY=
# Ad account used for the X-AP-Context header.
APPLE_ADS_ACCOUNT_ID=
# Alternatively provide a pre-generated client secret JWT instead of TEAM_ID/KEY_ID/PRIVATE_KEY.
APPLE_ADS_CLIENT_SECRET=

# --- App Store Connect analytics (V0.2, not used yet) ------------------------
APPLE_CONNECT_ISSUER_ID=
APPLE_CONNECT_KEY_ID=
APPLE_CONNECT_PRIVATE_KEY=

# --- Google Play reporting (V0.2, not used yet) ------------------------------
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
